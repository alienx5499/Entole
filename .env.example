# PayPal sandbox REST app client id (developer.paypal.com, Sandbox, Apps & Credentials).
PAYPAL_CLIENT_ID=
# PayPal sandbox REST app secret. Never commit a real value.
PAYPAL_CLIENT_SECRET=
# PayPal API base. Sandbox only: https://api-m.sandbox.paypal.com
PAYPAL_API_BASE=
# Id of the webhook created in the PayPal developer dashboard for <API URL>/api/paypal/webhook.
# Empty means the webhook route answers 503.
PAYPAL_WEBHOOK_ID=
# Groq API key (console.groq.com). Used by the shopping agent.
GROQ_API_KEY=
# Groq model. Leave empty to use the default, openai/gpt-oss-120b.
GROQ_MODEL=
# Channel3 API key (trychannel3.com). Used for search, product details and price tracking.
CHANNEL3_API_KEY=
# Signing secret (whsec_...) of the Channel3 webhook endpoint (dashboard > Webhooks). Optional.
CHANNEL3_WEBHOOK_SECRET=
# Neon Postgres connection string. Stores users, sessions, taste, mandates and audit entries.
DATABASE_URL=
# Public URL of the web app (the Vercel domain). PayPal return URLs are built from it.
PUBLIC_BASE_URL=
# Set to on to have PayPal ask Entole about the ship-to address during approval (US only).
# Needs an https PUBLIC_BASE_URL. Leave off until one sandbox approval has passed through it.
PAYPAL_SHIPPING_CALLBACK=
# Port the API listens on. Render sets this itself.
PORT=
# Minutes between watcher ticks for limit orders. Empty means 60 (keeps Neon asleep most of the hour).
WATCH_INTERVAL_MIN=
# Most mandates one user may create in 24 hours. Empty means 30.
MANDATE_DAILY_LIMIT_PER_USER=
# Most mandates all users together may create in 24 hours. Empty means 500.
MANDATE_DAILY_LIMIT_TOTAL=
# Who runs the watcher: timer (the API's own timer, default) or workflow (the Render Workflows task).
WATCHER_MODE=
# Cron job only: Render API key (dashboard, Account Settings, API Keys) used to start the workflow task.
RENDER_API_KEY=
# Cron job only: slug of the workflow service. Its name, entole-watcher, unless you renamed it.
WORKFLOW_SLUG=
# Web app only: base URL of the API (the Render service). Next.js rewrites /api/* to it.
API_URL=
# Web app only: AG Studio licence key for /dashboard. Empty works with a watermark.
NEXT_PUBLIC_AG_GRID_LICENSE_KEY=
# MCP server only (apps/mcp): the Entole web URL. Empty means https://entole.vercel.app.
ENTOLE_URL=
# MCP server only (apps/mcp): a personal access token from the Connect an AI page (ent_...).
ENTOLE_TOKEN=
