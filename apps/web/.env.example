# Base URL of the API (the Render service), no trailing slash. Next.js rewrites /api/* to it.
# Required for production builds (the build throws if it is missing).
# In development it falls back to http://localhost:8787 (the API's local PORT).
API_URL=

# AG Studio licence key for the /dashboard page (a trial key is fine). Public: it ships in the
# browser bundle, as AG keys are meant to. Empty still works, with a watermark and a console notice.
NEXT_PUBLIC_AG_GRID_LICENSE_KEY=
